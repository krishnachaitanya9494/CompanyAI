# PostgreSQL database username.
DB_USER=postgres

# Set your local PostgreSQL password in .env.
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# PostgreSQL server address.
DB_HOST=localhost

# Default PostgreSQL port.
DB_PORT=5432

# Name of the project database.
DB_NAME=companyai_db

# Set a newly generated OpenRouter API key in .env; never commit the real key.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Embedding model used by the OpenRouter embedding service.
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free

# OpenRouter chat model used for Nemotron JD analysis, separate from embeddings.
OPENROUTER_LLM_MODEL=nvidia/nemotron-3.5-super-vl
